modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
GITHUB_REPO = "owaisosama37/starfruit-control-room"
RESEND_CONNECTOR_ENABLED = "true"

[userenv.development]
INTEGRATIONS_ADMIN_USER_ID = "user_3Jrhw20qrZ5QYDhGc7mw6RJ78cK"
