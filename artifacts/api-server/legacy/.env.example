# Server Configuration
PORT=3000
NODE_ENV=development
HOST=localhost

# Database
MONGODB_URI=mongodb://localhost:27017/starfruit-control-room
DB_NAME=starfruit-control-room

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
HMAC_SECRET=your-super-secret-hmac-key-change-this-in-production
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Webhook Secrets
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
SLACK_WEBHOOK_SECRET=your-slack-webhook-secret
CUSTOM_WEBHOOK_SECRET=your-custom-webhook-secret

# GitHub Integration
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO_OWNER=your-github-username-or-org
GITHUB_REPO_NAME=your-repo-name

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@starfruit.local
SMTP_SECURE=false

# Dashboard & Frontend
DASHBOARD_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Token Budgets
DAILY_TOKEN_BUDGET=10000
MONTHLY_TOKEN_BUDGET=300000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Redis (optional, for session storage)
REDIS_URL=redis://localhost:6379

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_WEBSOCKETS=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SLACK_NOTIFICATIONS=true

# AI Model Endpoints
CLAUDE_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-opus-5.5

# System Settings
SYSTEM_MODE=manual
AUTO_ESCALATION_ENABLED=true
EMERGENCY_CONTACT_EMAIL=admin@starfruit.local

# Deployment
ENVIRONMENT=staging
DEPLOY_KEY=your-deployment-key
