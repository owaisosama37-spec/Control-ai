# Starfruit Control Room environment reference.
# Keep real values in Replit Secrets, never in this file or Git.
# Replit supplies PORT, BASE_PATH and, when Clerk is Replit-managed, Clerk keys.
# Vite supplies import.meta.env.BASE_URL. Production auth keys are managed
# separately from development keys.

# Core database (required for persistent app data).
MONGODB_URI=
MONGODB_DB_NAME=

# Clerk authentication (use the keys for the matching environment).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Optional override when Clerk uses a proxy URL.
VITE_CLERK_PROXY_URL=

# App-level administrator for integration settings (Clerk user ID).
INTEGRATIONS_ADMIN_USER_ID=
# Optional signing key; falls back to CLERK_SECRET_KEY when unset.
SESSION_SECRET=

# Architecture assistance: configure direct keys OR the matching
# AI_INTEGRATIONS_*_API_KEY + AI_INTEGRATIONS_*_BASE_URL pair via Replit.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional model overrides: choose models that support generation for your account.
CLAUDE_MODEL=
GEMINI_MODEL=

# GitHub webhook (both values required to configure GitHub integration).
GITHUB_WEBHOOK_SECRET=
GITHUB_REPO=

# Optional integrations. Connection status alone does not enable automated
# Slack commands, notifications, or email delivery.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVALS_CHANNEL=
EMAIL_FROM=
# Choose one email transport: connected Resend, direct Resend, or SMTP.
RESEND_CONNECTOR_ENABLED=false
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional server logging. NODE_ENV / REPLIT_DEPLOYMENT are runtime-provided.
LOG_LEVEL=info